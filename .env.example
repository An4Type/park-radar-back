# Compose uses the postgres service hostname internally.
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking_dev_password
POSTGRES_DB=parking
DATABASE_URL=postgresql://parking:parking_dev_password@postgres:5432/parking
NODE_ENV=development
PORT=3000
WORKER_MODE=mock
RECOGNITION_PROVIDER=mock
# Capacity 3 leaves spare room for failover among five seeded parkings.
MAX_PARKINGS_PER_WORKER=3
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
CAPTURE_INTERVAL_SECONDS=5
