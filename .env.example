# Compose uses the postgres service hostname internally.
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking_dev_password
POSTGRES_DB=parking
DATABASE_URL=postgresql://parking:parking_dev_password@postgres:5432/parking
NODE_ENV=development
PORT=3000

# Camera workers (apps/camera-worker): put the real key only in .env, never here.
# Set LOCAL_UID/LOCAL_GID to `id -u` / `id -g` so ./screenshots stays writable.
LOCAL_UID=1000
LOCAL_GID=1000
# Seconds between captures per camera (1–86400); defaults to 60.
CAPTURE_INTERVAL_SECONDS=60
# Shared secret camera workers use to push results to the API (required for ingestion).
INGEST_TOKEN=change-me-to-a-long-random-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# Cloudflare Tunnel token (profile: tunnel)
TUNNEL_TOKEN=
